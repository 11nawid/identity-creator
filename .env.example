# --- Optional: AI enhancement ---
# Works out-of-the-box WITHOUT any of these. The app includes a built-in
# offline generator (uses only bundled data + public DiceBear avatars + public
# coordinate lookups) and requires no API key, cookies, or tokens.

# Official AI API key (recommended if you want AI-generated output)
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Legacy web-connector settings. Only needed if you are NOT using an API key.
# Leave these empty unless you know what you are doing - they contain private session data.
# GEMINI_COOKIE_FILE=../cookies.txt
# GEMINI_DEFAULT_MODEL=gemini-3.6-flash
# GEMINI_PROXY=